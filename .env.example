# ──────────────────────────────────────────────────────────────
# PhoenixGuard — Required Environment Variables
# Copy this file to .env and fill in your secrets.
# Do NOT commit .env — it is ignored by .gitignore.
# ──────────────────────────────────────────────────────────────

# ── Google Gemini / ADK ──────────────────────────────────────
# Your Google AI Studio API key.  Used by both google-genai and
# google-adk.  The app maps GENAI_API_KEY → GOOGLE_API_KEY
# automatically, so either name works.
GOOGLE_API_KEY=your_google_api_key_here
GENAI_API_KEY=your_google_api_key_here

# ── Phoenix Cloud ────────────────────────────────────────────
# Get these from https://app.phoenix.arize.com → Settings
PHOENIX_API_KEY=your_phoenix_api_key_here
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space-id

# ── PhoenixGuard Options ─────────────────────────────────────
# Project name shown in Phoenix Cloud (default: phoenixguard)
PHOENIX_PROJECT_NAME=phoenixguard

# Override the Gemini model (default: gemini-2.5-flash)
# PHOENIXGUARD_MODEL=gemini-2.5-flash
